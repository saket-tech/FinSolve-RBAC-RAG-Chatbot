FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir streamlit==1.41.1 requests==2.32.3 python-dotenv==1.0.1

COPY streamlit_app/ ./streamlit_app/

ENV PYTHONUNBUFFERED=1

EXPOSE 8501

CMD ["streamlit", "run", "streamlit_app/app.py", "--server.port=8501", "--server.address=0.0.0.0", "--browser.gatherUsageStats=false"]
